# DharmaAI — environment values injected at build/run time via --dart-define.
# Copy the real values into run_dev.ps1 (git-ignored) for local dev,
# and into GitHub Secrets for CI. NEVER commit real values.

# AI (Google Gemini) — used by the AI guidance feature
GEMINI_API_KEY=your_gemini_api_key_here

# AI (OpenAI) — local-dev fallback only; production uses the Cloudflare Worker
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_WORKER_URL=https://dharma-ai-proxy.yourname.workers.dev

# Audio assets (Cloudflare R2 bucket / CDN)
R2_BUCKET_URL=https://audio.yourdomain.com

# Backend (Supabase) — Project → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
